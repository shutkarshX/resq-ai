# OpenAI (or other) API key — OPTIONAL. RESQ-AI runs fully without this
# using the deterministic fallback AI engine in app/ai_engine.py.
OPENAI_API_KEY=

# Database connection string. SQLite by default for local/demo use.
# To move to Postgres later, just change this — no code changes needed.
DATABASE_URL=sqlite:///./resq_ai.db

# Comma-separated list of origins allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
